#!/bin/sh
# Refuses a commit that contains something that looks like a Mozilla (AMO) API key or other secret.
# Enabled by: git config core.hooksPath .githooks   (the app's setup does this for you)
bad=$(git diff --cached -U0 --no-color -- . ':!extension/released.json' ':!rules.clearurls.json' | grep -E '^\+' | grep -E 'user:[0-9]{4,}:[0-9]+|"secret"[[:space:]]*:[[:space:]]*"[^"]{20,}"|AMO_JWT_SECRET=[^[:space:]]+|[0-9a-f]{64}' | grep -v 'PASTE-' | head -3)
if [ -n "$bad" ]; then
  echo "Commit stopped: this looks like a secret/API key in the staged changes:" >&2
  echo "$bad" | cut -c1-100 >&2
  echo "Keep credentials outside the repository (~/.config/trackbye/amo-credentials.json)." >&2
  exit 1
fi
