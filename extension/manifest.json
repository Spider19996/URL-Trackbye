{
  "manifest_version": 3,
  "name": "URL Trackbye",
  "version": "0.2.1",
  "description": "Removes tracking parameters from links before the page loads. Shares its rules with the trackbye program when installed.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": ["declarativeNetRequest", "nativeMessaging", "storage", "contextMenus", "scripting", "activeTab", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "URL Trackbye" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
